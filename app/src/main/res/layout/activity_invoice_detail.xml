                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layoutDirection="rtl"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <!-- دکمه ویرایش (سبز) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEdit"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1.1"
                        android:layout_margin="4dp"
                        android:text="ویرایش"
                        android:textColor="#388E3C"
                        app:strokeColor="#388E3C"
                        app:strokeWidth="2dp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_edit_modern"
                        app:iconTint="#388E3C" />

                    <!-- دکمه تصویر (آبی) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnInvoiceImage"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:layout_margin="4dp"
                        android:text="تصویر"
                        android:textColor="#1976D2"
                        app:strokeColor="#1976D2"
                        app:strokeWidth="2dp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_invoice_image_modern"
                        app:iconTint="#1976D2" />

                    <!-- دکمه حذف (قرمز) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDelete"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:layout_margin="4dp"
                        android:text="حذف"
                        android:textColor="#D32F2F"
                        app:strokeColor="#D32F2F"
                        app:strokeWidth="2dp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_delete_modern"
                        app:iconTint="#D32F2F" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
